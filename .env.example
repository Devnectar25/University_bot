# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# --- PRIMARY OPENROUTER CONFIGURATION ---
# OpenRouter API key used for embeddings and default chat completions
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=google/gemini-2.5-flash

# Optional: Additional OpenRouter keys for key rotation and quota fallback
# Can be specified as OPENROUTER_API_KEY_2, OPENROUTER_API_KEY_3, or comma-separated in OPENROUTER_API_KEYS
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEYS=key1,key2

# Optional: Custom chain of OpenRouter models (tried in order)
# OPENROUTER_MODELS=google/gemini-2.5-flash,openrouter/free,google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-7b-instruct:free

# --- INDEPENDENT GOOGLE GEMINI API FALLBACK ---
# Independent fallback provider when OpenRouter has outages, rate limits (429), or credit issues (402)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash
# Optional additional Gemini keys:
# GEMINI_API_KEY_2=
# GEMINI_API_KEYS=key1,key2
# Optional alternate Gemini models:
# GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-flash

# --- RAG & APPLICATION SETTINGS ---
# Earlier question/answer turns sent as context with each question
CHAT_HISTORY_WINDOW=5
EMBEDDING_METHOD=openrouter

# Optional: admin sign-in shown in the sidebar (leave blank to disable sign-in)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=
# Long random string used to sign the login cookie, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
